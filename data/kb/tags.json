{
 "_comment": "Разметка героев по механикам. Теги читает движок анализа: они превращаются в «угрозы драфта» и конкретные контрмеры из rules.json. Словарь — в поле vocabulary.",
 "vocabulary": {
  "burst_magical": {
   "title": "Магический бурст",
   "why": "убивает с одной связки, если поймает без БКБ/хила"
  },
  "burst_physical": {
   "title": "Физический бурст / высокий DPS",
   "why": "быстро сносит HP автоатаками и критами"
  },
  "invis": {
   "title": "Невидимость",
   "why": "не видно на карте, внезапные ганги; бесплатные инициации"
  },
  "illusions": {
   "title": "Иллюзии / клоны",
   "why": "разводят фокус, много целей, тяжело отличить настоящего"
  },
  "summons": {
   "title": "Саммоны и слуги",
   "why": "держат волну, толкают башни, забирают нейтралов"
  },
  "silence": {
   "title": "Сайленс / мут",
   "why": "выключает из боя, ломает каст и защиту"
  },
  "hex_root": {
   "title": "Хекс / рут",
   "why": "держит на месте и не даёт выйти из-под фокуса"
  },
  "heavy_lockdown": {
   "title": "Много контроля",
   "why": "длинные станы и цепочки контроля на всю команду"
  },
  "single_target_lockdown": {
   "title": "Ловит одну цель",
   "why": "вытаскивает тебя из позиции и убивает"
  },
  "evasion": {
   "title": "Уклонение / промахи",
   "why": "твои автоатаки не долетают, физический урон почти не работает"
  },
  "passives_core": {
   "title": "Живёт на пассивках",
   "why": "весь урон/защита героя — пассивные способности: Break выключает его"
  },
  "disables_passives": {
   "title": "Отключает пассивки",
   "why": "ломает твою защиту и ключевые пассивки"
  },
  "heavy_heal": {
   "title": "Сильное лечение и реген",
   "why": "переживает твой бурст и выходит из файта живым"
  },
  "save": {
   "title": "Спасает союзников",
   "why": "забранные цели остаются живыми: нужен разрыв связки"
  },
  "poke_lane": {
   "title": "Душит лейн",
   "why": "харрасит с безопасной дистанции, ломает твой фарм на линии"
  },
  "lane_sustain": {
   "title": "Танкует лейн",
   "why": "размены с ним невыгодны: он восстанавливается и держит волну"
  },
  "waveclear": {
   "title": "Быстро зачищает волну",
   "why": "держивает линию под своей башней, бесплатно забирает руны"
  },
  "gap_close": {
   "title": "Прыжок и догон",
   "why": "не оторваться пешком: нужен свой мобильный ответ"
  },
  "global": {
   "title": "Глобальное присутствие",
   "why": "участвует в твоих файтах, даже находясь на другом конце карты"
  },
  "mana_burn": {
   "title": "Выжигает ману",
   "why": "оставляет без маны без права на ошибку"
  },
  "roam_ganker": {
   "title": "Роумит и ганкает",
   "why": "приходит на мид через 1-2 минуты после пропажи с карты"
  },
  "teamfight_ultimate": {
   "title": "Командный ульт",
   "why": "решает файт 5v5 одним кастом: играй по частям"
  },
  "tower_pressure": {
   "title": "Давит на строения",
   "why": "заставляет команду дефить и забирает темп"
  },
  "late_scaler": {
   "title": "Сильный лейт",
   "why": "с каждым минутой становится хуже для тебя: играй быстро"
  },
  "magic_amp": {
   "title": "Усиливает магический урон",
   "why": "его связка бьёт больнее, чем ты ждёшь"
  },
  "armor_reduce": {
   "title": "Снижает броню",
   "why": "физический урон по тебе резко растёт"
  }
 },
